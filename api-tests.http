Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Mi Primer Workout",
    "exercises": [
        {
            "exerciseId": 1,
            "sets": 3,
            "reps": 10,
            "weight": 50
        }
    ],
    "notes": "Workout de prueba"
}

